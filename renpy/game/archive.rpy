## 資料庫画面。ステータス画面の「資料庫」ボタンから開く。
screen archive_screen():

    tag menu
    modal True

    add Solid("#000000cc")

    default archive_sel = None

    frame:
        xalign 0.5
        yalign 0.5
        xpadding 36
        ypadding 28
        background "#14141ee6"

        vbox:
            spacing 12

            text "資料庫" size 32 color "#ffe08a"

            $ archive_count = len(archive_items)
            text "収集済み: [archive_count] 件" size 20

            hbox:
                spacing 24

                ## 左: 文書一覧(フォールバック環境のため scrollbars なしの viewport)
                viewport:
                    xsize 330
                    ysize 430
                    mousewheel True
                    draggable True

                    vbox:
                        spacing 4
                        if archive_count == 0:
                            text "(まだ資料がない)" size 22
                        for arch_doc_id in archive_items:
                            textbutton ARCHIVE_DOCS[arch_doc_id][0]:
                                action SetScreenVariable("archive_sel", arch_doc_id)
                                text_size 20

                ## 右: 本文
                viewport:
                    xsize 640
                    ysize 430
                    mousewheel True
                    draggable True

                    vbox:
                        spacing 10
                        if archive_sel:
                            text ARCHIVE_DOCS[archive_sel][0] size 26 color "#ffe08a"
                            text ARCHIVE_DOCS[archive_sel][1] size 21
                        else:
                            text "左の一覧から資料を選んでください。" size 22

            textbutton "閉じる" action Return() xalign 0.5

    key "game_menu" action Return()
